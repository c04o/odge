<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="CitasList"
              pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

    <!-- Parámetros -->
    <parameter name="fechaEmision" class="java.util.Date"/>
    <parameter name="tituloReporte" class="java.lang.String"/>

    <!-- Fields que coinciden con la entidad Cita -->
    <field name="oid"                   class="java.lang.String"/>
    <field name="paciente.nombre"       class="java.lang.String"/>
    <field name="doctor.nombre"         class="java.lang.String"/>
    <field name="appointmentDateTime"   class="java.time.LocalDateTime"/>
    <field name="estado"                class="java.lang.String"/>
    <field name="observaciones"         class="java.lang.String"/>

    <!-- Banner superior -->
    <title>
        <band height="87" splitType="Stretch">
            <rectangle>
                <reportElement mode="Opaque"
                               x="-20" y="-20"
                               width="595" height="89"
                               backcolor="#0E97A1"/>
                <graphicElement>
                    <pen lineWidth="0.0" lineStyle="Dotted"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="0" y="9" width="390" height="30"/>
                <textElement>
                    <font fontName="Lucida Console" size="16"/>
                </textElement>
                <text><![CDATA[ODGE – Sistema de Gestión Odontológica]]></text>
            </staticText>

            <image>
                <reportElement x="480" y="-11" width="74" height="70"/>
                <imageExpression><![CDATA["logo_odge.png"]]></imageExpression>
            </image>
        </band>
    </title>

    <!-- Encabezado de página -->
    <pageHeader>
        <band height="54" splitType="Stretch">
            <textField>
                <reportElement x="10" y="12" width="250" height="30"/>
                <textElement>
                    <font size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{tituloReporte}]]></textFieldExpression>
            </textField>

            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="280" y="12" width="275" height="30"/>
                <textElement textAlignment="Right">
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA["Fecha de emisión: " + $P{fechaEmision}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <!-- Encabezado de columnas -->
    <columnHeader>
        <band height="24" splitType="Stretch">
            <staticText>
                <reportElement x="10" y="4" width="70" height="18"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Cód. cita]]></text>
            </staticText>

            <staticText>
                <reportElement x="80" y="4" width="90" height="18"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Paciente]]></text>
            </staticText>

            <staticText>
                <reportElement x="170" y="4" width="90" height="18"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Doctor]]></text>
            </staticText>

            <staticText>
                <reportElement x="260" y="4" width="90" height="18"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Fecha / hora]]></text>
            </staticText>

            <staticText>
                <reportElement x="350" y="4" width="70" height="18"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Estado]]></text>
            </staticText>

            <staticText>
                <reportElement x="420" y="4" width="150" height="18"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Observaciones]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detalle: una fila por cita -->
    <detail>
        <band height="20" splitType="Stretch">

            <!-- Código de la cita (oid) -->
            <textField>
                <reportElement x="10" y="2" width="70" height="16"/>
                <textFieldExpression><![CDATA[$F{oid}]]></textFieldExpression>
            </textField>

            <!-- Paciente -->
            <textField>
                <reportElement x="80" y="2" width="90" height="16"/>
                <textFieldExpression><![CDATA[$F{paciente.nombre}]]></textFieldExpression>
            </textField>

            <!-- Doctor -->
            <textField>
                <reportElement x="170" y="2" width="90" height="16"/>
                <textFieldExpression><![CDATA[$F{doctor.nombre}]]></textFieldExpression>
            </textField>

            <!-- Fecha / hora (LocalDateTime formateado) -->
            <textField>
                <reportElement x="260" y="2" width="90" height="16"/>
                <textFieldExpression><![CDATA[
                    $F{appointmentDateTime} == null
                        ? ""
                        : ((java.time.LocalDateTime) $F{appointmentDateTime})
                            .format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"))
                ]]></textFieldExpression>
            </textField>

            <!-- Estado -->
            <textField>
                <reportElement x="350" y="2" width="70" height="16"/>
                <textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression>
            </textField>

            <!-- Observaciones -->
            <textField isStretchWithOverflow="true">
                <reportElement x="420" y="2" width="150" height="16"/>
                <textFieldExpression><![CDATA[$F{observaciones}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <columnFooter>
        <band height="10" splitType="Stretch"/>
    </columnFooter>

    <pageFooter>
        <band height="40" splitType="Stretch">
            <textField>
                <reportElement x="0" y="10" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Sistema ODGE – Universidad Americana – Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="20" splitType="Stretch"/>
    </summary>

</jasperReport>


