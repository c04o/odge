<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="DoctorFicha"
              pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20"
              uuid="22222222-3333-4444-5555-666666666666">

    <parameter name="fechaEmision"   class="java.util.Date"/>
    <parameter name="codigoReporte"  class="java.lang.String"/>
    <parameter name="tituloReporte"  class="java.lang.String"/>

    <parameter name="doctorCodigo"         class="java.lang.String"/>
    <parameter name="doctorNombre"         class="java.lang.String"/>
    <parameter name="doctorEspecialidad"   class="java.lang.String"/>
    <parameter name="doctorDisponibilidad" class="java.lang.String"/>
    <parameter name="doctorNotas"          class="java.lang.String"/>

    <queryString><![CDATA[]]></queryString>

    <background>
        <band splitType="Stretch"/>
    </background>

    <title>
        <band height="80" splitType="Stretch">
            <rectangle>
                <reportElement x="-20" y="-20" width="595" height="90"
                               mode="Opaque" backcolor="#0E97A1"
                />
            </rectangle>

            <staticText>
                <reportElement x="0" y="10" width="390" height="24"
                />
                <textElement>
                    <font fontName="Lucida Console" size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[ODGE – Sistema de Gestión Odontológica]]></text>
            </staticText>

            <image>
                <reportElement x="480" y="-5" width="74" height="60"
                />
                <imageExpression><![CDATA["logo_odge.png"]]></imageExpression>
            </image>
        </band>
    </title>

    <pageHeader>
        <band height="40" splitType="Stretch">
            <textField>
                <reportElement x="0" y="8" width="260" height="20"
                />
                <textElement>
                    <font size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{tituloReporte}]]></textFieldExpression>
            </textField>

            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="260" y="8" width="295" height="20"
                />
                <textElement textAlignment="Right">
                    <font size="11"/>
                </textElement>
                <textFieldExpression><![CDATA["Fecha de emisión: " + $P{fechaEmision}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <columnHeader>
        <band height="50" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="5" width="80" height="18"
                />
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Nombre:]]></text>
            </staticText>
            <textField>
                <reportElement x="80" y="5" width="350" height="18"
                />
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{doctorNombre}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="27" width="80" height="18"
                />
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Código:]]></text>
            </staticText>
            <textField>
                <reportElement x="80" y="27" width="200" height="18"
                />
                <textFieldExpression><![CDATA[$P{doctorCodigo}]]></textFieldExpression>
            </textField>
        </band>
    </columnHeader>

    <detail>
        <band height="170" splitType="Stretch">

            <staticText>
                <reportElement x="0" y="0" width="100" height="16"
                />
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Especialidad:]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="0" width="180" height="16"
                />
                <textFieldExpression><![CDATA[$P{doctorEspecialidad}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="25" width="100" height="16"
                />
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Disponibilidad:]]></text>
            </staticText>
            <textField isStretchWithOverflow="true">
                <reportElement x="100" y="25" width="180" height="40"
                />
                <textElement verticalAlignment="Top">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{doctorDisponibilidad}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="290" y="0" width="250" height="16"
                />
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Notas / Comentarios sobre el doctor:]]></text>
            </staticText>

            <textField isStretchWithOverflow="true">
                <reportElement x="290" y="20" width="265" height="120"
                />
                <textElement verticalAlignment="Top">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{doctorNotas}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <columnFooter>
        <band height="40" splitType="Stretch">
            <textField>
                <reportElement x="0" y="10" width="200" height="20"
                />
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["CÓDIGO REPORTE: " + $P{codigoReporte}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="200" y="10" width="355" height="20"
                />
                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Sistema ODGE – Universidad Americana – Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </columnFooter>

    <pageFooter>
        <band height="10" splitType="Stretch"/>
    </pageFooter>

    <summary>
        <band height="10" splitType="Stretch"/>
    </summary>

</jasperReport>
