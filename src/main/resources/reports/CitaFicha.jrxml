<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="CitaFicha"
              pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

    <parameter name="fechaEmision"    class="java.util.Date"/>
    <parameter name="codigoReporte"   class="java.lang.String"/>
    <parameter name="tituloReporte"   class="java.lang.String"/>

    <parameter name="citaPaciente"        class="java.lang.String"/>
    <parameter name="citaDoctor"          class="java.lang.String"/>
    <parameter name="citaCodigo"          class="java.lang.String"/>
    <parameter name="citaEstado"          class="java.lang.String"/>
    <parameter name="citaFecha"           class="java.lang.String"/>
    <parameter name="citaObservaciones"   class="java.lang.String"/>

    <queryString><![CDATA[]]></queryString>

    <background>
        <band splitType="Stretch"/>
    </background>

    <title>
        <band height="80" splitType="Stretch">
            <rectangle>
                <reportElement x="-20" y="-20" width="595" height="90"
                               mode="Opaque" backcolor="#0E97A1"/>
            </rectangle>

            <staticText>
                <reportElement x="0" y="10" width="390" height="24"/>
                <textElement>
                    <font fontName="Lucida Console" size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[ODGE – Sistema de Gestión Odontológica]]></text>
            </staticText>

            <image>
                <reportElement x="480" y="-5" width="74" height="60"/>
                <imageExpression><![CDATA["logo_odge.png"]]></imageExpression>
            </image>
        </band>
    </title>

    <pageHeader>
        <band height="40" splitType="Stretch">
            <textField>
                <reportElement x="0" y="8" width="260" height="20"/>
                <textElement>
                    <font size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{tituloReporte}]]></textFieldExpression>
            </textField>

            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="260" y="8" width="295" height="20"/>
                <textElement textAlignment="Right">
                    <font size="11"/>
                </textElement>
                <textFieldExpression><![CDATA["Fecha de emisión: " + $P{fechaEmision}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <detail>
        <band height="200" splitType="Stretch">

            <staticText>
                <reportElement x="0" y="0" width="110" height="16"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Paciente:]]></text>
            </staticText>
            <textField>
                <reportElement x="120" y="0" width="400" height="16"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{citaPaciente}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="24" width="110" height="16"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Doctor:]]></text>
            </staticText>
            <textField>
                <reportElement x="120" y="24" width="400" height="16"/>
                <textFieldExpression><![CDATA[$P{citaDoctor}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="48" width="110" height="16"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Código cita:]]></text>
            </staticText>
            <textField>
                <reportElement x="120" y="48" width="200" height="16"/>
                <textFieldExpression><![CDATA[$P{citaCodigo}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="72" width="110" height="16"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Estado:]]></text>
            </staticText>
            <textField>
                <reportElement x="120" y="72" width="200" height="16"/>
                <textFieldExpression><![CDATA[$P{citaEstado}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="96" width="110" height="16"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Fecha:]]></text>
            </staticText>
            <textField>
                <reportElement x="120" y="96" width="250" height="16"/>
                <textFieldExpression><![CDATA[$P{citaFecha}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="130" width="110" height="16"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Observaciones:]]></text>
            </staticText>

            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="150" width="520" height="40"/>
                <textElement verticalAlignment="Top">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{citaObservaciones}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <columnFooter>
        <band height="40" splitType="Stretch">
            <textField>
                <reportElement x="0" y="10" width="200" height="20"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["CÓDIGO: " + $P{codigoReporte}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="200" y="10" width="355" height="20"/>
                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Sistema ODGE – Universidad Americana – Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </columnFooter>

    <pageFooter>
        <band height="10" splitType="Stretch"/>
    </pageFooter>

    <summary>
        <band height="10" splitType="Stretch"/>
    </summary>

</jasperReport>
