<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE controladores SYSTEM "dtds/controladores.dtd">

<controladores>

    <!-- PACIENTE: ficha -->
    <controlador nombre="PacienteReport">
        <hereda-de controlador="Typical"/>
        <accion nombre="imprimirFicha"
                icono="printer"
                clase="acciones.PrintPacienteReportAction"/>
    </controlador>

    <!-- DOCTOR: ficha -->
    <controlador nombre="DoctorReport">
        <hereda-de controlador="Typical"/>
        <accion nombre="imprimirFicha"
                icono="printer"
                clase="acciones.PrintDoctorReportAction"/>
    </controlador>

    <!-- MATERIAL: ficha -->
    <controlador nombre="MaterialReport">
        <hereda-de controlador="Typical"/>
